 "headerPatches": {
  "nccl-generated-header": {
   "header": "src/nccl.h.in",
   "includeRoot": "src",
   "output": "nccl.h",
   "edits": [
    {
     "pattern": "\\$\\{nccl:Major\\}",
     "replacement": "2"
    },
    {
     "pattern": "\\$\\{nccl:Minor\\}",
     "replacement": "30"
    },
    {
     "pattern": "\\$\\{nccl:Patch\\}",
     "replacement": "6"
    },
    {
     "pattern": "\\$\\{nccl:Suffix\\}",
     "replacement": "a0"
    },
    {
     "pattern": "\\$\\{nccl:Version\\}",
     "replacement": "23006"
    }
   ],
   "reason": "NCCL's build generates nccl.h from src/nccl.h.in with sed, substituting the version in makefiles/version.mk (2.30.6a0 at the case revision); this does the same."
  },
  "raft-span-enable-if": {
   "in": "raft",
   "header": "cpp/include/raft/core/span.hpp",
   "includeRoot": "cpp/include",
   "pattern": "class = typename std::enable_if<(\\s*detail::is_allowed_element_type_conversion_t)",
   "replacement": "class = std::enable_if_t<\\1",
   "reason": "raft::span's converting constructor defaults its last template parameter to std::enable_if<...> without ::type, so it never drops out of overload resolution. GCC does not instantiate the constexpr body while libstdc++'s std::variant checks a conversion; Clang does, and fails on every span<float> to span<double> conversion it considers. The patch uses std::enable_if_t, which removes the constructor when the conversion is not allowed."
  },
  "cccl-string-view-deduction-guides": {
   "in": "cccl",
   "header": "libcudacxx/include/cuda/std/string_view",
   "includeRoot": "libcudacxx/include",
   "pattern": "^_CCCL_HOST (basic_string_view\\()",
   "replacement": "\\1",
   "reason": "CCCL 3.1 marks the deduction guides from std::basic_string and std::basic_string_view _CCCL_HOST (__host__ in CUDA mode). nvcc accepts that; Clang rejects any deduction guide annotated other than __host__ __device__. A deduction guide declares no function body, so the patch drops the annotation, which Clang accepts and which deduces the same types."
  }
 }
