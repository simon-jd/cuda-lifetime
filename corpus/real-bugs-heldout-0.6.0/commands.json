 "headerPatches": {
  "catch2-user-config": {
   "in": "catch2",
   "header": "src/catch2/catch_user_config.hpp.in",
   "includeRoot": "src",
   "output": "catch2/catch_user_config.hpp",
   "edits": [
    {
     "pattern": "^#cmakedefine (\\w+).*$",
     "replacement": "/* #undef \\1 */"
    },
    {
     "pattern": "@CATCH_CONFIG_DEFAULT_REPORTER@",
     "replacement": "console"
    },
    {
     "pattern": "@CATCH_CONFIG_CONSOLE_WIDTH@",
     "replacement": "80"
    }
   ],
   "reason": "Catch2's build generates catch2/catch_user_config.hpp from catch_user_config.hpp.in with CMake's configure_file; with no CATCH_CONFIG_* option set, every #cmakedefine becomes an #undef comment and the default reporter and console width take Catch2's defaults (console, 80). This does the same."
  },
  "cudf-base-type-to-id": {
   "in": "cudf",
   "header": "cpp/include/cudf/utilities/type_dispatcher.hpp",
   "includeRoot": "cpp/include",
   "pattern": "^(\\s*)constexpr inline type_id base_type_to_id<",
   "replacement": "\\1CUDF_HOST_DEVICE constexpr inline type_id base_type_to_id<",
   "reason": "The patch of corpus/real-bugs/commands.json, applied to the cuDF dependency: the primary template base_type_to_id is __host__ __device__ and its explicit specializations are plain constexpr. nvcc accepts that; Clang ignores the implicit __host__ __device__ of constexpr when matching a specialization's CUDA target to its template and rejects all of them. The patch gives the specializations the template's attributes."
  },
  "gromacs-config": {
   "header": "src/config.h.cmakein",
   "includeRoot": "src",
   "output": "config.h",
   "edits": [
    {
     "pattern": "^#cmakedefine01 (GMX_GPU|GMX_GPU_CUDA|GMX_THREAD_MPI|GMX_SIMD_REFERENCE|GMX_GPU_FFT_CUFFT|HAVE_FSEEKO|HAVE_POSIX_MEMALIGN|HAVE_CLOCK_GETTIME|HAVE_GETTIMEOFDAY|HAVE_FSYNC|HAVE_FILENO|HAVE_SIGACTION|HAVE_BUILTIN_CLZ|HAVE_BUILTIN_CLZLL|HAVE_PWD_H|HAVE_DIRENT_H|HAVE_MM_MALLOC_H|HAVE_MALLOC_H|HAVE_XMMINTRIN_H|HAVE_SCHED_AFFINITY|HAVE__MM_MALLOC|HAVE_SIGUSR1|HAVE_PIPES|HAVE_FEENABLEEXCEPT|HAVE_FEDISABLEEXCEPT)\\s*$",
     "replacement": "#define \\1 1"
    },
    {
     "pattern": "^#cmakedefine01 (\\w+)\\s*$",
     "replacement": "#define \\1 0"
    },
    {
     "pattern": "^#cmakedefine (THREAD_PTHREADS|HAVE_UNISTD_H|HAVE_SYS_TIME_H|HAVE_SCHED_H|HAVE_SYSCONF|HAVE_PTHREAD_SETAFFINITY)\\b.*$",
     "replacement": "#define \\1"
    },
    {
     "pattern": "^#cmakedefine (\\w+).*$",
     "replacement": "/* #undef \\1 */"
    },
    {
     "pattern": "@GMX_GPU_NB_CLUSTER_SIZE@",
     "replacement": "8"
    },
    {
     "pattern": "@GMX_GPU_NB_NUM_CLUSTER_PER_CELL_X@",
     "replacement": "2"
    },
    {
     "pattern": "@GMX_GPU_NB_NUM_CLUSTER_PER_CELL_Y@",
     "replacement": "2"
    },
    {
     "pattern": "@GMX_GPU_NB_NUM_CLUSTER_PER_CELL_Z@",
     "replacement": "2"
    },
    {
     "pattern": "@GMX_SIMD_ACCURACY_BITS_SINGLE@",
     "replacement": "22"
    },
    {
     "pattern": "@GMX_SIMD_ACCURACY_BITS_DOUBLE@",
     "replacement": "44"
    },
    {
     "pattern": "@GMX_SIMD_CALLING_CONVENTION@",
     "replacement": ""
    },
    {
     "pattern": "@GMX_SIMD_ARM_SVE_LENGTH_VALUE@",
     "replacement": "0"
    },
    {
     "pattern": "@GMX_OPENMP_MAX_THREADS@",
     "replacement": "128"
    },
    {
     "pattern": "@GMX_HWLOC_API_VERSION@",
     "replacement": "0"
    },
    {
     "pattern": "@REQUIRED_OPENCL_MIN_VERSION_MAJOR@",
     "replacement": "1"
    },
    {
     "pattern": "@REQUIRED_OPENCL_MIN_VERSION_MINOR@",
     "replacement": "2"
    },
    {
     "pattern": "\"@[\\w-]+@\"",
     "replacement": "\"\""
    }
   ],
   "reason": "GROMACS's build generates config.h from src/config.h.cmakein with CMake's configure_file. This does the same for a CUDA build with thread-MPI, reference SIMD and cuFFT: the GPU, CUDA, thread-MPI, reference-SIMD and cuFFT switches and the POSIX features Linux has are 1, every other #cmakedefine01 is 0, #cmakedefine lines become #define for the POSIX features and #undef comments otherwise, numeric values take the defaults of a CUDA build (cluster size 8 with 2x2x2 clusters per cell, SIMD accuracy 22/44 bits, 128 OpenMP threads) and string values are empty."
  },
  "gromacs2019-config": {
   "header": "src/config.h.cmakein",
   "includeRoot": "src",
   "output": "config.h",
   "edits": [
    {
     "pattern": "^#cmakedefine01 (GMX_GPU|GMX_GPU_CUDA|GMX_THREAD_MPI|GMX_SIMD_REFERENCE|GMX_GPU_FFT_CUFFT|HAVE_FSEEKO|HAVE_POSIX_MEMALIGN|HAVE_CLOCK_GETTIME|HAVE_GETTIMEOFDAY|HAVE_FSYNC|HAVE_FILENO|HAVE_SIGACTION|HAVE_BUILTIN_CLZ|HAVE_BUILTIN_CLZLL|HAVE_PWD_H|HAVE_DIRENT_H|HAVE_MM_MALLOC_H|HAVE_MALLOC_H|HAVE_XMMINTRIN_H|HAVE_SCHED_AFFINITY|HAVE__MM_MALLOC|HAVE_SIGUSR1|HAVE_PIPES|HAVE_FEENABLEEXCEPT|HAVE_FEDISABLEEXCEPT)\\s*$",
     "replacement": "#define \\1 1"
    },
    {
     "pattern": "^#cmakedefine01 (\\w+)\\s*$",
     "replacement": "#define \\1 0"
    },
    {
     "pattern": "^#cmakedefine (THREAD_PTHREADS|HAVE_UNISTD_H|HAVE_SYS_TIME_H|HAVE_SCHED_H|HAVE_SYSCONF|HAVE_PTHREAD_SETAFFINITY)\\b.*$",
     "replacement": "#define \\1"
    },
    {
     "pattern": "^#cmakedefine (\\w+).*$",
     "replacement": "/* #undef \\1 */"
    },
    {
     "pattern": "@GMX_SIMD_ACCURACY_BITS_SINGLE@",
     "replacement": "22"
    },
    {
     "pattern": "@GMX_SIMD_ACCURACY_BITS_DOUBLE@",
     "replacement": "44"
    },
    {
     "pattern": "@GMX_SIMD_CALLING_CONVENTION@",
     "replacement": ""
    },
    {
     "pattern": "@GMX_OPENMP_MAX_THREADS@",
     "replacement": "128"
    },
    {
     "pattern": "@REQUIRED_OPENCL_MIN_VERSION_MAJOR@",
     "replacement": "1"
    },
    {
     "pattern": "@REQUIRED_OPENCL_MIN_VERSION_MINOR@",
     "replacement": "2"
    },
    {
     "pattern": "@GMX_GPU_ACCELERATION_FRAMEWORK@",
     "replacement": "GMX_GPU_CUDA"
    },
    {
     "pattern": "@GMX_OPENCL_NB_CLUSTER_SIZE@",
     "replacement": "8"
    },
    {
     "pattern": "\"@[\\w-]+@\"",
     "replacement": "\"\""
    }
   ],
   "reason": "As gromacs-config, for the 2019 template: GMX_GPU is set to GMX_GPU_CUDA through @GMX_GPU_ACCELERATION_FRAMEWORK@ and the OpenCL cluster size is 8; only the substitutions that occur in that template are applied."
  },
  "gromacs-gmxpre-config": {
   "header": "src/gmxpre-config.h.cmakein",
   "includeRoot": "src",
   "output": "gmxpre-config.h",
   "edits": [
    {
     "pattern": "^#cmakedefine01 (\\w+)\\s*$",
     "replacement": "#define \\1 0"
    },
    {
     "pattern": "^#cmakedefine (\\w+).*$",
     "replacement": "/* #undef \\1 */"
    }
   ],
   "reason": "GROMACS's build generates gmxpre-config.h from src/gmxpre-config.h.cmakein; with large-file macros and the FAH core off, every #cmakedefine01 is 0 and every #cmakedefine an #undef comment. This does the same."
  }
 }
