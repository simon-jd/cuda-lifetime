{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "properties": {
        "skipReason": "no reachable CUDA calls in this TU or declared models",
        "assumptions": [
          "CUDA calls with discarded return values are assumed successful; explicitly checked failure paths are explored",
          "single device",
          "single host thread"
        ],
        "coverage": {
          "parsed": 54,
          "failed": 0,
          "translationUnknown": 0,
          "budgetExhausted": 61,
          "unmodeledCudaCalls": 33,
          "coverageUnknown": 118,
          "diagnostics": 0,
          "complete": false
        }
      },
      "results": [],
      "tool": {
        "driver": {
          "name": "cuda-lifetime",
          "version": "0.6.0",
          "rules": [
            {
              "id": "CL1",
              "name": "Host access before asynchronous copy completes",
              "shortDescription": {
                "text": "Host access before asynchronous copy completes"
              }
            },
            {
