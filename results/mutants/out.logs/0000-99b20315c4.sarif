{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/cos02/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "artifacts": [],
      "columnKind": "unicodeCodePoints",
      "results": [],
      "tool": {
        "driver": {
          "fullName": "Clang Static Analyzer: CUDA asynchronous lifetime",
          "informationUri": "https://clang.llvm.org/docs/UsersManual.html",
          "language": "en-US",
          "name": "cuda-lifetime-native",
          "rules": [
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1
              },
              "fullDescription": {
                "text": "Host access before asynchronous copy completes"
              },
              "id": "CL1",
              "name": "Host access before asynchronous copy completes"
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1
              },
              "fullDescription": {
                "text": "Host buffer lifetime ends before asynchronous copy completes"
              },
              "id": "CL2",
              "name": "Host buffer lifetime ends before asynchronous copy completes"
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1
              },
              "fullDescription": {
                "text": "Stream-ordered allocation lifetime violation"
              },
              "id": "CL3",
              "name": "Stream-ordered allocation lifetime violation"
            },
            {
              "defaultConfiguration": {
                "enabled": true,
                "level": "warning",
                "rank": -1
              },
              "fullDescription": {
                "text": "Event capture does not cover the producer"
              },
              "id": "CL4",
              "name": "Event capture does not cover the producer"
            }
          ],
          "version": "0.5.0 (clang version 23.1.3)"
        }
      }
    }
  ],
  "version": "2.1.0"
}
